{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InvokeIngest",
      "Effect": "Allow",
      "Action": ["lambda:InvokeFunction"],
      "Resource": "arn:aws:lambda:us-east-1:069318857278:function:pbj-ingest"
    },
    {
      "Sid": "RunGlueJobs",
      "Effect": "Allow",
      "Action": ["glue:StartJobRun", "glue:GetJobRun", "glue:GetJobRuns", "glue:BatchStopJobRun"],
      "Resource": "arn:aws:glue:us-east-1:069318857278:job/pbj-*"
    }
  ]
}